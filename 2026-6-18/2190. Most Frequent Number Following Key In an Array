func mostFrequent(nums []int, key int) int {
    m := make(map[int]int)

    // loop đến n-1 để tránh trường hợp out of index
    for i:=0; i < len(nums)-1; i++ {
        if nums[i] == key {
            target := nums[i+1]
            m[target]++
        }
    }

    maxCount := 0
    ans := 0

    for k, v := range m {
        if v > maxCount {
            maxCount = v
            ans = k
        }
    }

    return ans
}