/**
 * Definition for singly-linked list.
 * type ListNode struct {
 *     Val int
 *     Next *ListNode
 * }
 */
func reorderList(head *ListNode)  {
    if head == nil || head.Next == nil {
        return
    }
    slow := head
    fast := head

    for fast != nil && fast.Next != nil {
        slow = slow.Next
        fast = fast.Next.Next
    }

    // head2 := &ListNode{}
    head2 := slow.Next
    slow.Next = nil

    var prev *ListNode = nil
    curr := head2

    for curr != nil {
        nextTemp := curr.Next
        curr.Next = prev

        prev = curr
        curr = nextTemp
    }

    head2 = prev

    list1 := head
    list2 := head2

    for list2 != nil {
        next1 := list1.Next
        next2 := list2.Next

        list1.Next = list2
        list2.Next = next1

        list1 = next1
        list2 = next2
    }




}