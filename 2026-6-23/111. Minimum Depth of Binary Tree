/**
 * Definition for a binary tree node.
 * type TreeNode struct {
 *     Val int
 *     Left *TreeNode
 *     Right *TreeNode
 * }
 */
func minDepth(root *TreeNode) int {
    if root == nil {
        return 0
    }

    left := minDepth(root.Left)
    right := minDepth(root.Right)

    if root.Left == nil {
        return right + 1
    }

    if root.Right == nil {
        return left + 1
    }

    if left < right {
        return left + 1
    }
    return right + 1
}