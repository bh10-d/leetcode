import (
    "strings"
)
func capitalizeTitle(title string) string {
    convertToLower := strings.ToLower(title)
    arrayOfString := strings.Fields(convertToLower)
    for i:=0;i<len(arrayOfString);i++{
        if len(arrayOfString[i]) > 2{
            arrayOfString[i] = strings.ToUpper(arrayOfString[i][0:1])  + arrayOfString[i][1:]
        }
    }

    return strings.Join(arrayOfString, " ")
}

