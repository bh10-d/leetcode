func timeRequiredToBuy(tickets []int, k int) int {
    time := 0

    for i := 0; i < len(tickets); i++ {
        if i <= k {
            if tickets[i] < tickets[k] {
                time += tickets[i]
            }else {
                time += tickets[k]
            }
        }
        if i > k {
            if tickets[i] < tickets[k] {
                time += tickets[i]
            }else {
                time = time + tickets[k] - 1
            }
        }
    }

    return time
}