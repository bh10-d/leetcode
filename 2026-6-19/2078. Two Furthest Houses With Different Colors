func maxDistance(colors []int) int {
    n := len(colors)
    maxDist := 0

    for i := n-1; i >= 0; i-- {
        if colors[i] != colors[0] {
            dist := i - 0
            if maxDist < dist {
                maxDist = dist
            }
            break
        }
    }

    for i := 0; i < n; i++ {
        if colors[i] != colors[n-1] {
            dist := n - 1 - i
            if dist > maxDist {
                maxDist = dist
            }
        }
    }
    return maxDist
}