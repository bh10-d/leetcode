func fib(n int) int {
    // Trường hợp cơ sở nếu n bằng 0 hoặc 1 thì trả về chính n
    if n <= 1 {
        return n
    }

    a := 0 // Đại diện cho F(0)
    b := 1 // Đại diện cho F(1)

    // Chạy từ 2 đến n để tính số Fibonacci tiếp theo
    for i := 2; i <= n; i++ {
        next := a + b
        a = b    // Dịch chuyển: số liền trước cũ trở thành số của bước trước
        b = next // Dịch chuyển: số hiện tại nhận giá trị mới vừa tính
    }

    return b
}