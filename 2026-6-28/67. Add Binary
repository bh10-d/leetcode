func addBinary(a string, b string) string {
    i := len(a) - 1
    j := len(b) - 1
    carry := 0
    result := ""

    // Chạy chừng nào vẫn còn chữ số để cộng hoặc vẫn còn biến nhớ
    for i >= 0 || j >= 0 || carry > 0 {
        sum := carry

        if i >= 0 {
            sum += int(a[i] - '0') // Đổi ký tự thành số bằng cách trừ đi '0'
            i--
        }
        if j >= 0 {
            sum += int(b[j] - '0')
            j--
        }

        // Ký tự mới sẽ là số dư (0 hoặc 1)
        result = string(byte(sum%2)+'0') + result
        // Biến nhớ mới (0 hoặc 1)
        carry = sum / 2
    }

    return result
}