/**
 * Definition for a binary tree node.
 * type TreeNode struct {
 *     Val int
 *     Left *TreeNode
 *     Right *TreeNode
 * }
 */
func isSubtree(root *TreeNode, subRoot *TreeNode) bool {
    if root ==  nil {
        return false
    }

    // sử dụng code của bài 100 là hàm check trùng để dùng cho bài này
    // tại 1 node thì nó sẽ check xuống để xem có trùng k
    if isSameTree(root, subRoot) {
        return true
    }

    // đệ quy cho đến khi 1 trong 2 nhánh trái phải trùng hoặc đệ quy hết chạm đáy mà k có
    return isSubtree(root.Left, subRoot) || isSubtree(root.Right, subRoot)
}

func isSameTree(p *TreeNode, q *TreeNode) bool{
    if p == nil && q == nil {
        return true
    }

    if p == nil || q == nil {
        return false
    }

    if p.Val != q.Val {
        return false
    }

    return isSameTree(p.Left, q.Left) && isSameTree(p.Right, q.Right)
}