func minMaxGame(nums []int) int {
    // Lặp cho đến khi mảng rút gọn lại còn đúng 1 phần tử
    for len(nums) > 1 {
        n := len(nums)
        nextNums := make([]int, n/2)
        
        for i := 0; i < n/2; i++ {
            if i%2 == 0 {
                // Nhóm chẵn: Lấy giá trị nhỏ hơn
                nextNums[i] = min(nums[2*i], nums[2*i+1])
            } else {
                // Nhóm lẻ: Lấy giá trị lớn hơn
                nextNums[i] = max(nums[2*i], nums[2*i+1])
            }
        }
        // Thay mảng cũ bằng mảng mới đã rút gọn gọn gàng
        nums = nextNums
    }
    
    return nums[0]
}

// Hàm phụ tìm min, max (Go 1.21+ đã có sẵn nhưng viết thế này để bao pass mọi phiên bản LeetCode)
func min(a, b int) int {
    if a < b { return a }
    return b
}

func max(a, b int) int {
    if a > b { return a }
    return b
}