func sumOfTheDigitsOfHarshadNumber(x int) int {
    sumOfDigits := 0
    temp := x
    
    // Tách và cộng dồn từng chữ số
    for temp > 0 {
        sumOfDigits += temp % 10
        temp /= 10
    }
    
    // Kiểm tra xem số ban đầu có chia hết cho tổng các chữ số không
    if x % sumOfDigits == 0 {
        return sumOfDigits
    }
    
    return -1
}