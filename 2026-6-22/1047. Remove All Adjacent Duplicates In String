func removeDuplicates(s string) string {
    stack := []byte{}

    for i := 0; i < len(s); i++ {
        v := s[i]

        if len(stack) > 0 && v == stack[len(stack)-1] {
            stack = stack[:len(stack)-1]
        }else {
            stack = append(stack, v)
        }
    }

    return string(stack)
}