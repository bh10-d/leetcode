func search(nums []int, target int) int {
    left := 0
    right := len(nums) - 1

    for left <= right {
        mid := (left+right)/2

        if nums[mid] == target {
            return mid
        }else if nums[mid] < target {
            left = mid + 1 // target nằm bên phải dời tường trái tiến lên
        }else {
            right = mid - 1 // target nằm bên trái dời tường phải lùi về
        }
    }

    return -1
}