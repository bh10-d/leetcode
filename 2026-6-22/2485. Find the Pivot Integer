func pivotInteger(n int) int {
    totalSum := n * (n+1) /2
    left := 0
    right := n

    for left <= right {
        mid := (left+right)/2

        square := mid * mid

        if square == totalSum {
            return mid
        }else if square < totalSum {
            left = mid + 1
        }else {
            right = mid - 1
        }
    }
    return -1
}