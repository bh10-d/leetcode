func removeDuplicates(nums []int) int {
    if len(nums) == 0 {
        return 0
    }
    
    i := 0

    for j := 1; j < len(nums); j++ {
        if nums[i] != nums[j] {
            i++
            // ghi đè luôn vì người ta chỉ yêu cầu check i + 1 phần tử của mảng
            nums[i] = nums[j]
        }
    }

    return i + 1
}