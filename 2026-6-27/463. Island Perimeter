func islandPerimeter(grid [][]int) int {
    rows := len(grid)
    cols := len(grid[0])

    var dfs func(r int, c int) int

    dfs = func(r int, c int) int {
        // đi ra ngoài biên hoặc gặp nước (0) => tìm thấy 1 cạnh chu vi
        if r < 0 || r >= rows || c < 0 || c >= cols || grid[r][c] == 0 {
            return 1
        }

        // gặp ô đất đã duyệt (-1) => quay xe, không đếm lại
        if grid[r][c] == -1 {
            return 0
        }
        
        // đánh dấu ô đất đã duyệt bằng - 1
        grid[r][c] = -1

        // lan ra 4 hướng: dưới, trên, phải, trái
        return dfs(r+1, c) + dfs(r-1,c) + dfs(r, c+1) + dfs(r,c-1)
    }

    // duyệt qua ma trận để tìm ô đất đầu tiên kích hoạt DFS

    for r := 0; r < rows; r++ {
        for c := 0; c < cols; c++{
            if grid[r][c] == 1 {
                return dfs(r,c)
            }
        }
    }

    return 0
}